# Firebase Web SDK config (safe to expose; restrict via Firebase security rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATORS=true

# Server-only: full service-account JSON as a single line. Used by /api functions
# and scripts/seed-admin.mjs. Never prefix with VITE_ and never commit it.
FIREBASE_SERVICE_ACCOUNT=
